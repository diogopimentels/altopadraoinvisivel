# ==========================================
# ATENÇÃO: NUNCA COLOQUE SUAS CHAVES REAIS AQUI!
# Este é apenas um arquivo de exemplo para referência.
# Copie para .env.local e preencha os valores.
# ==========================================

# [FRONTEND/BACKEND] Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_ou_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# [BACKEND] Senha do Painel Administrativo (/admin)
ADMIN_PASSWORD=sua_senha_super_segura_aqui

# [BACKEND] Melhor Envio
MELHOR_ENVIO_ENVIRONMENT=production
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# Seed inicial (depois o refresh grava no Supabase integration_tokens)
MELHOR_ENVIO_ACCESS_TOKEN=
MELHOR_ENVIO_REFRESH_TOKEN=

# Cron Vercel (Authorization: Bearer ...)
CRON_SECRET=

# [Mercado Pago] Checkout Pro
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxx
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Assinatura secreta do webhook (só existe em produção no painel)
MERCADOPAGO_WEBHOOK_SECRET=
# sandbox | production
MERCADOPAGO_ENVIRONMENT=production

# URL pública (prod ou tunnel local)
# NEXT_PUBLIC_APP_URL=https://loja.altopadraoinvisivel.com.br

# --- Legado ---
# INFINITEPAY_TAG=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
